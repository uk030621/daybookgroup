# Copy to .env.local for local development. Never commit .env.local.

MONGODB_URI=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Daybook <reminders@your-domain.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Comma-separated emails of the app's owner(s). These people can see the
# /admin overview page and are the only ones who can create groups
# (everyone else is invited into them). If this is left empty, anyone can
# create a group.
PLATFORM_ADMIN_EMAILS=

# Push notifications — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
